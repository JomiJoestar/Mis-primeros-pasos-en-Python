


#La funcion bool valida datos.

#CON DATOS TIPO NUMERICOS

print(bool(0)) #esto es False

print(bool(0.0)) #esto es False

print(bool(27)) #esto es True

#CON DATOS TIPO CADENAS

print(bool("")) #esto es False, no tiene nada
print(bool(" ")) #esto es True, el espacio cuenta como un caracter
print(bool("Hola, my name is Jomi"))


#en conclusion los datos que la funcion bool valida como False son: 0 ,  0.0 , "" , False  

print(bool(False))
print(bool(True))


#ERROR COMUN DE PRINCIPIANTE

respuesta_usuario = "False" #Esto es texto

#La funcion bool evalua si el string esta vacio, SOLO CHECA SI LA CADENA ESTA VACIA.
es_verdad = bool(respuesta_usuario)

print(f"El valor es: {es_verdad}")

#OUTPUT: EL VALOR ES: TRUE
# POR QUE?  PORQUE EL STRING "FALSE" TIENE 5 LETRAS. NO ESTA VACIO

#  FORMA CORRECTA DE VALIDAR EL VACIO
texto_vacio = ""
print(bool(texto_vacio)) #esto es false




